# OpenRouter generation (keep OPENROUTER_API_KEY only in an untracked .env file)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3-30b-a3b-instruct-2507
OPENROUTER_TIMEOUT_SECONDS=60
OPENROUTER_MAX_TOKENS=4096
OPENROUTER_TEMPERATURE=0.1
OPENROUTER_MAX_RETRIES=1
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=AI Conference Research Assistant

# Local service addresses used by Docker Compose
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_USER=admin
OPENSEARCH_PASS=
REDIS_URL=redis://redis:6379/0
SEARXNG_URL=http://searxng:8080
SEARXNG_SECRET=

# Durable multi-user platform. Generate a distinct random password before the
# first deployment; do not commit the real value.
POSTGRES_DB=ai_conference
POSTGRES_USER=ai_conference
POSTGRES_PASSWORD=
MAX_UPLOAD_BYTES=26214400
MAX_PDF_PAGES=100
MAX_INDEX_QUEUE=30
MAX_GENERATION_QUEUE=80
MAX_OWNER_INDEX_JOBS=3
MAX_OWNER_GENERATION_JOBS=1
SESSION_TTL_DAYS=30
OCR_DPI=150
OCR_MAX_WORKERS=2
OCR_PAGE_BATCH=2
OCR_RENDER_TIMEOUT_SECONDS=90
API_MEMORY_LIMIT=768m
EMBEDDINGS_MEMORY_LIMIT=2g
INDEX_WORKER_MEMORY_LIMIT=2g
GENERATION_WORKER_MEMORY_LIMIT=1g
LLM_MAX_CONCURRENCY=2
LOCAL_QUERY_CACHE_LIMIT=256
# Optional server-only secret used by /metrics (never expose it in Streamlit).
ADMIN_METRICS_TOKEN=
